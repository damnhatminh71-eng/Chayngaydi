using UnityEngine;

public class PlayerMovement : MonoBehaviour
{
    [Header("Movement")]
    public float walkSpeed = 5f;
    public float runSpeed = 8f;
    private float currentSpeed;
    private float horizontalInput;
    private bool isFacingRight = true;

    [Header("Jumping")]
    public float jumpForce = 12f;
    public Transform groundCheck;
    public LayerMask groundLayer;
    private bool isGrounded;
    private float groundCheckRadius = 0.2f;

    [Header("Crouching")]
    public float crouchSpeedMultiplier = 0.5f;
    public Collider2D crouchDisableCollider; // Collider phần đầu cần tắt khi ngồi
    private bool isCrouching = false;

    private Rigidbody2D rb;
    private Animator anim; // Nếu bạn có thiết lập Animation

    void Start()
    {
        rb = GetComponent<Rigidbody2D>();
        anim = GetComponent<Animator>();
        currentSpeed = walkSpeed;
    }

    void Update()
    {
        // 1. Lấy input di chuyển ngang
        horizontalInput = Input.GetAxisRaw("Horizontal");

        // 2. Kiểm tra trạng thái chạy nhanh (Giữ Shift)
        if (Input.GetKey(KeyCode.LeftShift) && !isCrouching)
        {
            currentSpeed = runSpeed;
        }
        else
        {
            currentSpeed = walkSpeed;
        }

        // 3. Kiểm tra mặt đất (Ground Check)
        isGrounded = Physics2D.OverlapCircle(groundCheck.position, groundCheckRadius, groundLayer);

        // 4. Nhảy (Phím Space)
        if (Input.GetButtonDown("Jump") && isGrounded && !isCrouching)
        {
            rb.velocity = new Vector2(rb.velocity.x, jumpForce);
        }

        // 5. Ngồi (Giữ phím S hoặc Mũi tên xuống)
        if (Input.GetKey(KeyCode.S) || Input.GetKey(KeyCode.DownArrow))
        {
            if (isGrounded)
            {
                isCrouching = true;
            }
        }
        else
        {
            // Kiểm tra phía trên đầu xem có vật cản không trước khi đứng dậy (tùy chọn)
            isCrouching = false;
        }

        // 6. Xử lý Collider và Tốc độ khi ngồi
        if (isCrouching)
        {
            currentSpeed = walkSpeed * crouchSpeedMultiplier;
            if (crouchDisableCollider != null) crouchDisableCollider.enabled = false; 
        }
        else
        {
            if (crouchDisableCollider != null) crouchDisableCollider.enabled = true;
        }

        // 7. Cập nhật Animation (Nếu có)
        UpdatePositionAndAnimations();
    }

    void FixedUpdate()
    {
        // Thực hiện di chuyển vật lý
        rb.velocity = new Vector2(horizontalInput * currentSpeed, rb.velocity.y);

        // Quay mặt nhân vật theo hướng đi
        if (horizontalInput > 0 && !isFacingRight)
        {
            Flip();
        }
        else if (horizontalInput < 0 && isFacingRight)
        {
            Flip();
        }
    }

    void Flip()
    {
        isFacingRight = !isFacingRight;
        Vector3 scaler = transform.localScale;
        scaler.x *= -1;
        transform.localScale = scaler;
    }

    void UpdatePositionAndAnimations()
    {
        if (anim != null)
        {
            anim.SetFloat("Speed", Mathf.Abs(horizontalInput * currentSpeed));
            anim.SetBool("IsGrounded", isGrounded);
            anim.SetBool("IsCrouching", isCrouching);
        }
    }

    // Vẽ vùng kiểm tra Ground Check trên Editor để dễ căn chỉnh
    private void OnDrawGizmosSelected()
    {
        if (groundCheck != null)
        {
            Gizmos.color = Color.red;
            Gizmos.DrawWireSphere(groundCheck.position, groundCheckRadius);
        }
    }
}
